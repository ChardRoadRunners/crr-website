---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import ContourBackdrop from '../components/ContourBackdrop.astro';
import ContourDivider from '../components/ContourDivider.astro';
import ImageFallback from '../components/ImageFallback.astro';
import ShareRaceReport from '../components/ShareRaceReport.astro';
import Layout from './Layout.astro';
import { objectPosition } from '../utils/crop';
import {
	allRacesSameDay,
	formatDistance,
	getEarliestRaceDate,
	postedIsMeaningfullyLater,
} from '../utils/race-reports';

type Props = CollectionEntry<'race-reports'>['data'];

const {
	title,
	races,
	posted,
	dateApproximate,
	author,
	category,
	clubRace,
	heroImage,
	heroImageAlt,
	heroImageCrop,
	images,
	excerpt,
} = Astro.props;

const earliestRaceDate = getEarliestRaceDate(races);
const sameDay = allRacesSameDay(races);
const showPosted = postedIsMeaningfullyLater(posted, earliestRaceDate);
---

<Layout
	title={title}
	description={excerpt}
	image={heroImage}
	shareImage={heroImage ? `/race-reports/${Astro.params.slug}/share.jpg` : undefined}
	overlayHeader
>
	{/*
	  The masthead. Everything about the post — what it is, what it covers, who
	  wrote it — on the club colour, then white for the reading. The purple did
	  branding work in the homepage hero and nowhere else on the site; this is
	  the same idea applied to the page type there are most of.
	*/}
	<header class="report-masthead relative overflow-hidden bg-primary text-primary-content">
		{/*
		  0.25, not the hero's 0.5. Measured: white text where the lighter
		  contour stroke crosses a letter is 4.13:1 at 0.5, which fails AA for
		  anything at body size. At 0.25 it is 8.01:1.
		*/}
		<ContourBackdrop opacity={0.25} />
		<div class="relative z-1 mx-auto max-w-3xl px-4 pt-28 pb-10 text-center sm:px-6 sm:pt-32 sm:pb-12 lg:px-8">
			<div>
				<span class="badge badge-chalk badge-sm">{category}</span>
				{clubRace && <span class="badge badge-chalk-outline badge-sm ml-2">Club race</span>}
			</div>
			<h1 class="mt-3 text-3xl font-bold text-balance sm:text-4xl">{title}</h1>
			<div class="mt-3 text-sm text-primary-content/85">
				{sameDay && <FormattedDate date={earliestRaceDate} approximate={dateApproximate} />}
				{author && <span> · {author}</span>}
			</div>
			{
				showPosted && (
					<div class="text-xs text-primary-content/70 italic">
						Posted <FormattedDate date={posted!} />
					</div>
				)
			}
			<ul class="mt-5 flex flex-wrap justify-center gap-2">
				{races.map((race) => (
					<li class="badge badge-chalk-outline badge-wrap gap-1">
						<span class="font-semibold">{race.name}</span>
						{race.distance && <span>· {formatDistance(race.distance)}</span>}
						{!sameDay && (
							<span>
								· <FormattedDate date={race.raceDate} approximate={dateApproximate} />
							</span>
						)}
					</li>
				))}
			</ul>
		</div>
	</header>

	<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="aspect-[2/1] overflow-hidden rounded-box shadow-md">
			{heroImage ? (
				<Image
					width={1020}
					src={heroImage}
					alt={heroImageAlt ?? ''}
					class="h-full w-full object-cover"
					style={{ objectPosition: objectPosition(heroImageCrop) }}
				/>
			) : (
				<ImageFallback />
			)}
		</div>
		<div class="prose py-8">
			<slot />
		</div>
		{
			/* Only where there are photos: the divider marks the report ending
			   and the pictures starting, so with no pictures it marks nothing. */
			images && images.length > 0 && (
				<div class="my-8 overflow-hidden rounded-box">
					<ContourDivider />
				</div>
			)
		}

		{
			/* Each photo whole, at its own shape — a width and no height. Given
			   both, the build cut every gallery photo to 3:2 from the middle,
			   which took the tops and bottoms off portrait shots. The grid is
			   uneven where landscape and portrait mix; that was chosen over
			   cropping, 17 October 2026. items-start keeps a short photo from
			   being stretched to its taller neighbour's row. */
			images && images.length > 0 && (
				<div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-2">
					{images.map((img) => (
						<figure>
							<Image width={600} src={img.src} alt={img.alt} class="h-auto w-full rounded-box shadow-md" />
							{img.alt && <figcaption class="mt-1 text-center text-sm text-base-content/60">{img.alt}</figcaption>}
						</figure>
					))}
				</div>
			)
		}

		<div class="mt-10 border-t border-base-300 pt-6">
			<ShareRaceReport title={title} excerpt={excerpt} />
		</div>
	</article>
</Layout>
