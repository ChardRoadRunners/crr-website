---
// Handicap, championship and records. The race diary used to live here too —
// it moved to /calendar, because "when is the next race" and "how did we do"
// are different questions and a page answering both buried the first under
// the second.
//
// Laid out as sketch D from the 28 October 2026 feedback round, which Jack
// and Wayne both chose: links to each section and "Find your name" at the top,
// then the newest results first — the monthly handicap, then the championship
// with how far through the season it is, then records.
//
// The championship standings are read from the club's Google Sheet at build
// time. The scoring happens in the sheet's own formulas; nothing is worked out
// here. See docs/results.md for the sheet and src/consts.ts for the address.
//
// The monthly handicap is read the same way, from the CRR Handicap sheet's
// Results tab — the timing page in that sheet decides positions and the
// winner. Records have no backend yet, so they say so in their own words
// rather than showing an empty table.
import { getEntry } from 'astro:content';

import ChampionshipStandings from '../components/ChampionshipStandings.astro';
import FindYourName from '../components/FindYourName.astro';
import FormattedDate from '../components/FormattedDate.astro';
import HandicapResults from '../components/HandicapResults.astro';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import RichText from '../components/RichText.astro';
import { CHAMPIONSHIP_SEASON } from '../consts';
import { getChampionshipStandings, racesScored } from '../utils/championship';
import { buildRunnerIndex } from '../utils/find-your-name';
import { getHandicapResults } from '../utils/handicap-results';

const page = await getEntry('pages', 'results');
if (page?.data.page !== 'results') throw new Error('src/content/pages/results.md is missing.');
const { hero, seo, jumpLabel, search, championship, handicap, records, footnote } = page.data;

// null while the Standings tab has not been published. Any other problem with
// a published sheet throws and takes the build with it, on purpose — a
// standings table that quietly loses half the club is worse than a red deploy.
const standings = await getChampionshipStandings();

// Same rules: null while the Results tab is not published, a thrown error for
// anything else.
const handicapResults = await getHandicapResults();

// "13 of 15 races run." and the races nobody has a result for yet, both
// counted from the sheet — see racesScored.
const scored = standings ? racesScored(standings) : 0;
const progress = standings
	? championship.progress
			.replaceAll('{run}', String(scored))
			.replaceAll('{total}', String(standings.races.length))
	: null;
const toCome = standings
	? standings.races.filter((_, i) =>
			[...standings.women, ...standings.men].every((runner) => runner.racePoints[i] === null),
		)
	: [];
const stillToCome =
	toCome.length > 0
		? championship.stillToCome.replaceAll(
				'{races}',
				new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(toCome),
			)
		: null;

const runners = buildRunnerIndex(standings, handicapResults, search);

// Ids are spelled out rather than derived, because they are the anchors other
// pages link to: /results/#handicap from every night page, #championship from
// the homepage.
const sections = [
	{ id: 'handicap', heading: handicap.heading },
	{ id: 'championship', heading: championship.heading },
	{ id: 'records', heading: records.heading },
];
---

<Layout title="Results" description={seo.description} overlayHeader>
	<PageHeader heading={hero.heading} strapline={hero.strapline} />

	<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
		<nav aria-label={jumpLabel} class="flex flex-wrap gap-2">
			{
				sections.map((section) => (
					<a href={`#${section.id}`} class="btn btn-sm btn-outline btn-primary">
						{section.heading}
					</a>
				))
			}
		</nav>

		{runners.length > 0 && <FindYourName runners={runners} words={search} />}

		<section id="handicap" class="mt-12 scroll-mt-20">
			<h2 class="text-3xl font-bold text-primary">{handicap.heading}</h2>
			<RichText text={handicap.body} class="mt-3 text-base-content/80" />

			{
				handicapResults === null ? (
					handicap.notPublished && (
						<p class="mt-4 text-base-content/80">{handicap.notPublished}</p>
					)
				) : (
					<>
						<HandicapResults
							results={handicapResults}
							labels={handicap.labels}
							latestHeading={handicap.latestHeading}
							latestLink={handicap.latestLink}
							winnerLabel={handicap.winnerLabel}
							noWinner={handicap.noWinner}
							firstHandicapLabel={handicap.firstHandicapLabel}
							earlierHeading={handicap.earlierHeading}
							winnerOnlyNote={handicap.winnerOnlyNote}
							emptyState={handicap.emptyState}
						/>
						<p class="mt-6 text-sm text-base-content/60">
							{handicap.updatedLabel}{' '}
							<FormattedDate date={handicapResults.readAt} weekday={false} />.{' '}
							{handicap.updatedNote}
						</p>
					</>
				)
			}
		</section>

		{/* id="championship" is also the target of the redirect from the old site's
		    /club-championship, in public/_redirects. Rename it there too. */}
		<section id="championship" class="mt-12 scroll-mt-20 border-t border-base-300 pt-8">
			<h2 class="text-3xl font-bold text-primary">
				{championship.heading} {CHAMPIONSHIP_SEASON}
			</h2>
			{
				progress && (
					<p class="mt-2 font-semibold text-base-content">
						{progress}
						{stillToCome && <span class="font-normal text-base-content/80"> {stillToCome}</span>}
					</p>
				)
			}
			<RichText text={championship.intro} class="mt-3 text-base-content/80" />

			{
				championship.formUrl !== '' && (
					<p class="mt-4">
						<a class="btn btn-accent" href={championship.formUrl}>
							{championship.formLabel}
						</a>
					</p>
				)
			}

			{
				standings === null ? (
					<p class="mt-6 text-base-content/80">{championship.notPublished}</p>
				) : (
					<>
						<ChampionshipStandings
							standings={standings}
							womenHeading={championship.womenHeading}
							menHeading={championship.menHeading}
							labels={championship.labels}
							gridHeading={championship.gridHeading}
							gridIntro={championship.gridIntro}
							gridRegionLabel={championship.gridRegionLabel}
							emptyState={championship.emptyState}
						/>

						{championship.scoreNote && (
							<p class="mt-6 text-sm text-base-content/70">{championship.scoreNote}</p>
						)}

						<p class="mt-6 text-sm text-base-content/60">
							{championship.updatedLabel}{' '}
							<FormattedDate date={standings.readAt} weekday={false} />.{' '}
							{championship.updatedNote}
						</p>
					</>
				)
			}

			{
				championship.rules.length > 0 && (
					<div class="mt-8">
						<h3 class="text-xl font-semibold text-primary">{championship.rulesHeading}</h3>
						<ul class="mt-3 list-disc space-y-1 pl-5 text-base-content/80">
							{championship.rules.map((rule) => (
								<li>{rule}</li>
							))}
						</ul>
					</div>
				)
			}
		</section>

		{/* Still waiting on a backend. */}
		<section id="records" class="mt-12 scroll-mt-20 border-t border-base-300 pt-8">
			<h2 class="text-3xl font-bold text-primary">{records.heading}</h2>
			<p class="mt-3 text-base-content/80">{records.body}</p>
			{records.notPublished && <p class="mt-2 text-sm text-base-content/60">{records.notPublished}</p>}
		</section>

		<RichText
			text={footnote}
			class="mt-12 border-t border-base-300 pt-8 text-base-content/80"
		/>
	</div>
</Layout>
