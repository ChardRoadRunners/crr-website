---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { splitWhat3Words } from '../utils/what3words';
import RichText from '../components/RichText.astro';
import ContourBackdrop from '../components/ContourBackdrop.astro';
// The same picture the contact page uses — one file, shown smaller here.
// See docs/handover.md for how it is drawn and why it is not an embed.
import mapImage from '../assets/chard-cricket-club-map.png';

const entry = await getEntry('pages', 'join-us');
// The `page` check both proves the file is there and narrows it to the
// join-us shape, so the sections below are type-checked.
if (entry?.data.page !== 'join-us') throw new Error('Missing src/content/pages/join-us.md');

const { hero, firstVisit, whichNight, membership, couchTo5k, questions } = entry.data;
---

<Layout title={hero.heading} description={hero.strapline}
	overlayHeader
>
	<PageHeader heading={hero.heading} strapline={hero.strapline} center />

	<section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold text-primary sm:text-4xl">{firstVisit.heading}</h2>
			{firstVisit.intro && <RichText text={firstVisit.intro} class="mt-4 text-lg text-base-content/80" />}
		</div>
		<div class="card mt-10 border border-base-300 bg-base-100 shadow-sm">
			<div class="card-body">
				<dl class="divide-y divide-base-300">
					{
						firstVisit.steps.map((step) => (
							<div class="grid gap-1 py-5 first:pt-0 last:pb-0 sm:grid-cols-[9rem_1fr] sm:gap-6">
								<dt class="font-bold text-primary">{step.label}</dt>
								<dd class="whitespace-pre-line text-base-content/80">
									{splitWhat3Words(step.detail.trim()).map((part) =>
										part.href ? (
											<a
												href={part.href}
												target="_blank"
												rel="noopener noreferrer"
												class="link link-primary font-medium wrap-anywhere"
											>
												{part.text}
											</a>
										) : (
											<Fragment>{part.text}</Fragment>
										)
									)}

									{step.map && (
										/*
										  The dd is whitespace-pre-line so the address keeps its
										  line breaks, which would also turn the gaps in this
										  markup into blank lines — hence whitespace-normal here.

										  Smaller than the contact page's: the address and
										  what3words are right above it, so this is orientation
										  rather than the main event.
										*/
										<figure class="step-map mt-4 max-w-sm whitespace-normal">
											<a
												href={step.map.url}
												target="_blank"
												rel="noopener noreferrer"
												class="group block rounded-box focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
											>
												<Image
													src={mapImage}
													alt={step.map.alt}
													widths={[320, 384, 768]}
													sizes="(min-width: 640px) 24rem, 100vw"
													class="w-full rounded-box border border-base-300"
												/>
												<span class="mt-2 inline-block font-medium text-primary underline">
													{step.map.linkLabel}
												</span>
											</a>
											<figcaption class="mt-1 text-xs text-base-content/60">
												{step.map.credit}
											</figcaption>
										</figure>
									)}
								</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
		<RichText text={firstVisit.reassurance} class="mx-auto mt-10 max-w-2xl text-center text-lg text-base-content/80" />
	</section>

	<section class="bg-base-200">
		<div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
			<h2 class="text-center text-3xl sm:text-4xl font-bold text-primary">{whichNight.heading}</h2>
			<ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
				<li class="card border border-base-300 bg-base-100 shadow-sm">
					<div class="card-body">
						<RichText text={whichNight.tuesday} class="text-base-content/80" />
					</div>
				</li>
				<li class="card border border-base-300 bg-base-100 shadow-sm">
					<div class="card-body">
						<RichText text={whichNight.thursday} class="text-base-content/80" />
					</div>
				</li>
			</ul>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl sm:text-4xl font-bold text-primary">{membership.heading}</h2>
			{membership.intro && <RichText text={membership.intro} class="mt-3 text-base-content/80" />}
		</div>
		<ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
			{
				membership.options.map((option) => (
					<li class="card border border-base-300 bg-base-100 shadow-sm">
						<div class="card-body">
							<h3 class="card-title text-primary">{option.name}</h3>
							<p class="text-4xl font-bold text-primary">{option.price}</p>
							<p class="text-base-content/80">{option.detail}</p>
						</div>
					</li>
				))
			}
		</ul>
		<div class="card mt-6 border border-base-300 bg-base-200">
			<div class="card-body items-center text-center">
				<RichText text={membership.howToPay} class="text-base-content/80" />
				<p class="mt-1 select-all rounded-box bg-base-100 px-6 py-3 font-mono text-2xl font-bold tracking-widest text-primary">
					{membership.connectMyClubCode}
				</p>
				{membership.renewal && <RichText text={membership.renewal} class="mt-1 text-base-content/80" />}
				<p class="mt-1 text-base-content/80">
					<a href={`mailto:${membership.membershipEmail}`} class="link link-primary font-medium wrap-anywhere">
						{membership.membershipEmail}
					</a>
				</p>
			</div>
		</div>
	</section>

	<section class="relative overflow-hidden bg-primary text-primary-content">
		<ContourBackdrop />
		<div class="relative z-1 mx-auto max-w-2xl px-4 py-16 text-center sm:px-6 lg:px-8">
			<h2 class="text-3xl sm:text-4xl font-bold">{couchTo5k.heading}</h2>
			<RichText text={couchTo5k.body} class="mt-4 text-primary-content/80" />
			{
				couchTo5k.nextCourse ? (
					<p class="mt-6 inline-block rounded-box bg-primary-content/10 px-5 py-2 font-semibold">
						{couchTo5k.nextCourse}
					</p>
				) : (
					<p class="mt-6 rounded-box border border-dashed border-primary-content/40 px-5 py-3 text-primary-content/70">
						{couchTo5k.emptyState}
					</p>
				)
			}
		</div>
	</section>

	<section class="bg-base-200">
		<div class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6 lg:px-8">
			<h2 class="text-3xl font-bold text-primary">{questions.heading}</h2>
			<p class="mt-3 text-base-content/80">{questions.body}</p>
		</div>
	</section>
</Layout>

<style>
	/*
	  daisyUI lays out any <figure> inside a .card as a centred flex row, and
	  this one is inside the "your first night" card — which put the
	  OpenStreetMap credit beside the map instead of under it. Block flow is
	  what a captioned image wants here.
	*/
	.step-map {
		display: block;
	}
</style>
