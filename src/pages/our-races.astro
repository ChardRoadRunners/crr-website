---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import ImageFallback from '../components/ImageFallback.astro';
import { formatDistance } from '../utils/distance';
import Layout from '../layouts/Layout.astro';
import { resolveRaceDate } from '../utils/calendar';

const now = new Date();

/*
  The date comes from the club-races calendar, which is what the committee
  actually edits and what carries a start time. A race's content file can still
  name a date for one the calendar has not got yet; if both exist and disagree,
  resolveRaceDate fails the build rather than quietly picking one.
*/
const races = await Promise.all(
	(await getCollection('races'))
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (race) => ({
			race,
			when: await resolveRaceDate(race.data.title, race.data.nextDate, now),
		})),
);
---

<Layout title="Our Races" description="The Chard Flyer and Forde Abbey 10k, hosted by Chard Road Runners.">
	<section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
		<h1 class="text-center text-4xl font-bold text-primary">Our Races</h1>
		<ul class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2">
			{
				races.map(({ race, when }) => {
					const { data } = race;
					const note = data.seriesNote || data.juniorRaceNote;
					return (
						<li class="overflow-hidden rounded-box border border-base-300 shadow-sm">
							<div class="aspect-[2/1] overflow-hidden">
								{data.heroImage ? (
									<Image
										width={640}
										height={320}
										src={data.heroImage}
										alt={data.heroImageAlt ?? ''}
										class="h-full w-full object-cover object-hero"
									/>
								) : (
									<ImageFallback />
								)}
							</div>
							<div class="p-5">
								<div class="flex flex-wrap items-center gap-2">
									<h2 class="text-xl font-bold text-base-content">{data.title}</h2>
									{data.juniorRace && <span class="badge badge-purple">Junior race</span>}
								</div>
								<p class="mt-1 text-sm text-base-content/60">
									{when.date ? (
										<FormattedDate
											date={when.date}
											timeZone={when.showTime ? 'Europe/London' : 'UTC'}
										/>
									) : (
										'Date to be confirmed'
									)}
									{' · '}
									{formatDistance(data.distance)}
									{data.venue && ` · ${data.venue}`}
								</p>
								{note && <p class="mt-3 text-base-content/70">{note}</p>}
								<div class="mt-4 flex flex-wrap items-center gap-3">
									{data.entriesOpen && data.entryUrl ? (
										<a href={data.entryUrl} class="btn btn-accent btn-sm">
											Enter now
										</a>
									) : (
										<span class="badge badge-outline">Entries not yet open</span>
									)}
									{data.resultsUrl && (
										<a href={data.resultsUrl} class="link link-primary text-sm">
											Results
										</a>
									)}
									{data.facebookEventUrl && (
										<a href={data.facebookEventUrl} class="link link-primary text-sm">
											Facebook event
										</a>
									)}
								</div>
								{/*
								  Below the buttons rather than beside them: it is what you want
								  when the entry link has not answered your question, so it reads
								  after them. A real mailto, per CLAUDE.md — an address somebody
								  has to retype is an address they do not use.
								*/}
								{data.contactEmail && (
									<p class="mt-4 border-t border-base-300 pt-3 text-sm text-base-content/70">
										Questions about this race?{' '}
										<a href={`mailto:${data.contactEmail}`} class="link link-primary">
											{data.contactEmail}
										</a>
									</p>
								)}
							</div>
						</li>
					);
				})
			}
		</ul>
	</section>
</Layout>
