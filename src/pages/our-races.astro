---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Band from '../components/Band.astro';
import ContourDivider from '../components/ContourDivider.astro';
import ImageFallback from '../components/ImageFallback.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatDistance } from '../utils/distance';
import Layout from '../layouts/Layout.astro';
import { resolveRaceDate } from '../utils/calendar';
import { objectPosition } from '../utils/crop';

const now = new Date();

const page = await getEntry('pages', 'our-races');
if (page?.data.page !== 'our-races') throw new Error('src/content/pages/our-races.md is missing.');
const words = page.data;

/*
  The date comes from the club-races calendar, which is what the committee
  actually edits and what carries a start time. A race's content file can still
  name a date for one the calendar has not got yet; if both exist and disagree,
  resolveRaceDate fails the build rather than quietly picking one.
*/
const races = await Promise.all(
	(await getCollection('races'))
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (race) => ({
			race,
			when: await resolveRaceDate(race.data.title, race.data.nextDate, now),
			// The race file's own text: route, race day, prizes, marshals.
			Content: (await render(race)).Content,
		})),
);

// "11:00:00" from the CMS time picker, shown as "11:00".
const startLabel = (time?: string) => (time && /^\d{2}:\d{2}/.test(time) ? time.slice(0, 5) : undefined);
---

{/*
  The purple banner like every other page, then one band per race with a
  contour divider between them (set 19 November 2026). Until then this page
  started on white under a solid menu bar and showed the races as two cards
  side by side; one race to a band leaves room for the two more races the
  club means to add, with no layout change when they arrive.

  The races are all white, separated by the divider rather than by taking
  turns with pale purple: the one place the colour rule in CLAUDE.md lets a
  page use more than one divider, because the races are a list of equals.
*/}
<Layout title={words.hero.heading} description={words.seo.description} overlayHeader>
	<PageHeader heading={words.hero.heading} />
	{
		races.map(({ race, when, Content }, index) => {
			const { data } = race;
			const note = data.seriesNote || data.juniorRaceNote;
			const start = startLabel(data.startTime);
			return (
				<>
					{index > 0 && <ContourDivider />}
					<Band tone="white">
						<article class="overflow-hidden rounded-box border border-base-300 shadow-sm sm:grid sm:grid-cols-2">
							<div class="aspect-[2/1] overflow-hidden sm:aspect-auto sm:h-full">
								{data.heroImage ? (
									<Image
										width={640}
										src={data.heroImage}
										alt={data.heroImageAlt ?? ''}
										class="h-full w-full object-cover"
										style={{ objectPosition: objectPosition() }}
									/>
								) : (
									<ImageFallback />
								)}
							</div>
							<div class="p-5">
								<div class="flex flex-wrap items-center gap-2">
									<h2 class="text-xl font-bold text-base-content">{data.title}</h2>
									{data.juniorRace && <span class="badge badge-purple">{words.juniorRaceBadge}</span>}
								</div>
								<p class="mt-1 text-sm text-base-content/60">
									{when.date ? (
										<FormattedDate
											date={when.date}
											timeZone={when.showTime ? 'Europe/London' : 'UTC'}
										/>
									) : (
										words.dateToBeConfirmed
									)}
									{' · '}
									{formatDistance(data.distance)}
									{start && ` · ${words.startsLabel.replace('{time}', start)}`}
									{data.venue && ` · ${data.venue}`}
								</p>
								{data.raceDirector && !data.raceDirector.includes('TODO') && (
									<p class="mt-1 text-sm text-base-content/70">{words.raceDirectorLabel.replace('{name}', data.raceDirector)}</p>
								)}
								{note && <p class="mt-3 text-base-content/70">{note}</p>}
								<div class="mt-4 flex flex-wrap items-center gap-3">
									{data.entriesOpen && data.entryUrl ? (
										<a href={data.entryUrl} class="btn btn-accent btn-sm">
											{words.enterLabel}
										</a>
									) : (
										<span class="badge badge-outline">{words.entriesNotOpenLabel}</span>
									)}
									{data.resultsUrl && (
										<a href={data.resultsUrl} class="link link-primary text-sm">
											{words.resultsLabel}
										</a>
									)}
									{data.facebookEventUrl && (
										<a href={data.facebookEventUrl} class="link link-primary text-sm">
											{words.facebookEventLabel}
										</a>
									)}
								</div>
								{/*
								  Below the buttons rather than beside them: it is what you want
								  when the entry link has not answered your question, so it reads
								  after them. A real mailto, per CLAUDE.md — an address somebody
								  has to retype is an address they do not use.
								*/}
								{data.contactEmail && (
									<p class="mt-4 border-t border-base-300 pt-3 text-sm text-base-content/70">
										{words.questionsLabel}{' '}
										<a href={`mailto:${data.contactEmail}`} class="link link-primary">
											{data.contactEmail}
										</a>
									</p>
								)}
							</div>
						</article>
						{/*
						  The race file's text, under its card (added 19 November 2026).
						  Its headings are h3, under the race's h2 in the card.
						*/}
						<div class="prose mx-auto max-w-3xl pt-8">
							<Content />
						</div>
					</Band>
				</>
			);
		})
	}
</Layout>
