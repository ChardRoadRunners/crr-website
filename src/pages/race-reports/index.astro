---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import ImageFallback from '../../components/ImageFallback.astro';
import ContourDivider from '../../components/ContourDivider.astro';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getEarliestRaceDate, sortByRaceDateDesc } from '../../utils/race-reports';
import { objectPosition } from '../../utils/crop';

const posts = sortByRaceDateDesc(await getCollection('race-reports', ({ data }) => !data.draft));
---

<Layout
	title="Race Reports"
	description="Race reports and club news from Chard Road Runners."
	overlayHeader
>
	{/* TODO content: move this heading and strapline into the pages collection,
	    so the committee can edit them like every other page's. Hardcoded for now
	    because the archive had no <h1> at all, and fixing the outline should not
	    wait on a schema change. */}
	<PageHeader
		heading="Race reports"
		strapline="What members wrote about the races they ran."
	/>

	<section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
		<ul class="grid grid-cols-1 gap-8 sm:grid-cols-2">
			{
				posts.map((post, index) => (
					<>
						{/* After the lead report, which already spans both columns:
						    the break between the newest one and the archive. */}
						{index === 1 && (
							<li class="overflow-hidden rounded-box sm:col-span-2">
								<ContourDivider />
							</li>
						)}
					<li class:list={[{ 'sm:col-span-2': index === 0 }]}>
						<a href={`/race-reports/${post.id}/`} class="group block">
							<div class="mb-2 aspect-[2/1] overflow-hidden rounded-box">
								{post.data.heroImage ? (
									<Image width={720} src={post.data.heroImage} alt={post.data.heroImageAlt ?? ''} class="h-full w-full object-cover" style={{ objectPosition: objectPosition(post.data.heroImageCrop) }} />
								) : (
									<ImageFallback />
								)}
							</div>
							<div class="flex items-center gap-2">
								<h2 class:list={['font-bold text-base-content group-hover:underline', index === 0 ? 'text-3xl' : 'text-xl']}>
									{post.data.title}
								</h2>
								{post.data.clubRace && <span class="badge badge-secondary badge-sm badge-wrap w-fit shrink-0">Club race</span>}
							</div>
							<p class="text-base-content/60">
								<FormattedDate date={getEarliestRaceDate(post.data.races)} approximate={post.data.dateApproximate} />
							</p>
							<p class="mt-1 text-base-content/70">{post.data.excerpt}</p>
						</a>
					</li>
					</>
				))
			}
		</ul>
	</section>
</Layout>
