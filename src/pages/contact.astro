---
// Who to email, and what about.
//
// The page holds one address of its own — the general one. Membership, welfare
// and the two races each already have an owner, so this reads from there. That
// is deliberate: a copy of the welfare address here would go stale silently the
// day somebody updated the welfare page, and a safeguarding concern would go
// into a dead mailbox with nothing failing.
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import RichText from '../components/RichText.astro';
import mapImage from '../assets/chard-cricket-club-map.png';

const page = await getEntry('pages', 'contact');
if (!page || page.data.page !== 'contact') {
	throw new Error('src/content/pages/contact.md is missing or is not a contact page.');
}
const { hero, intro, general, membership, welfare, races: racesCopy, whereWeAre, committee } =
	page.data;

// Written as lines in the content file, rendered as lines here.
const addressLines = whereWeAre.address.split('\n').map((l) => l.trim()).filter(Boolean);

const [joinUs, welfarePage, races] = await Promise.all([
	getEntry('pages', 'join-us'),
	getEntry('legal', 'welfare'),
	getCollection('races'),
]);

const membershipEmail =
	joinUs?.data.page === 'join-us' ? joinUs.data.membership.membershipEmail : undefined;
const welfareOfficer = welfarePage?.data.welfareOfficer;

const raceContacts = races
	.sort((a, b) => a.data.order - b.data.order)
	.filter((race) => race.data.contactEmail)
	.map((race) => ({ title: race.data.title, email: race.data.contactEmail! }));

// The committee list repeats the membership, welfare and race addresses,
// because a list of roles missing those three would look broken. The blocks
// above still read them from their owners; this checks the list agrees, and
// stops the build if it does not. A stale welfare address on this page would
// send a safeguarding concern into a dead mailbox with nothing failing — a
// failed build with this message in it is the better outcome.
const committeeRoles = committee.roles.filter((entry) => entry.name || entry.email);
for (const entry of committeeRoles) {
	if (!entry.email) continue;
	const fix = (owner: string) =>
		`Contact page, committee list: "${entry.role}" says ${entry.email}, but ${owner}. ` +
		'Change the committee list in src/content/pages/contact.md (Pages › Contact in the CMS) to match.';
	if (/welfare officer/i.test(entry.role) && welfareOfficer && entry.email !== welfareOfficer.email) {
		throw new Error(fix(`the welfare page says ${welfareOfficer.email}`));
	}
	if (/membership/i.test(entry.role) && membershipEmail && entry.email !== membershipEmail) {
		throw new Error(fix(`the Join us page says ${membershipEmail}`));
	}
	if (/race director/i.test(entry.role) && !raceContacts.some((r) => r.email === entry.email)) {
		throw new Error(fix(`no race page uses that address`));
	}
}
---

<Layout title="Contact" description="Who to email at Chard Road Runners, and what about."
	overlayHeader
>
	<PageHeader heading={hero.heading} strapline={hero.strapline} />

	<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
		<RichText text={intro} class="text-base-content/80" />

		<dl class="mt-8 flex flex-col gap-6">
			<div class="contact-entry">
				<dt class="font-bold text-primary">{general.label}</dt>
				<dd class="mt-1 text-base-content/80">
					<RichText text={general.detail} />
					<a href={`mailto:${general.email}`} class="link link-primary wrap-anywhere">{general.email}</a>
				</dd>
			</div>

			{
				membershipEmail && (
					<div class="contact-entry">
						<dt class="font-bold text-primary">{membership.label}</dt>
						<dd class="mt-1 text-base-content/80">
							<RichText text={membership.detail} />
							<a href={`mailto:${membershipEmail}`} class="link link-primary wrap-anywhere">
								{membershipEmail}
							</a>
						</dd>
					</div>
				)
			}

			{
				welfareOfficer && (
					<div class="contact-entry">
						<dt class="font-bold text-primary">{welfare.label}</dt>
						<dd class="mt-1 text-base-content/80">
							<RichText text={welfare.detail} />
							<a href={`mailto:${welfareOfficer.email}`} class="link link-primary wrap-anywhere">
								{welfareOfficer.email}
							</a>
							{/* Named, because who reads a welfare concern matters more than
							    where it lands. */}
							<p class="text-sm text-base-content/60">
								Our welfare officer is {welfareOfficer.name}.{' '}
								<a href="/welfare" class="link">What happens next</a>.
							</p>
						</dd>
					</div>
				)
			}

			{
				raceContacts.length > 0 && (
					<div class="contact-entry">
						<dt class="font-bold text-primary">{racesCopy.label}</dt>
						<dd class="mt-1 text-base-content/80">
							<RichText text={racesCopy.detail} />
							<ul class="mt-1 flex flex-col gap-1">
								{raceContacts.map((race) => (
									<li>
										{race.title} —{' '}
										<a href={`mailto:${race.email}`} class="link link-primary wrap-anywhere">
											{race.email}
										</a>
									</li>
								))}
							</ul>
						</dd>
					</div>
				)
			}
		</dl>

		{/*
		  A picture of a map rather than an embedded one. An iframe from a map
		  provider would load a third-party script on the page that carries the
		  welfare address, set cookies, and need a line on the privacy page —
		  for a view that never changes. This is a PNG drawn from OpenStreetMap
		  and committed, so the page stays self-contained.

		  The anchor wraps the image AND visible text: with images off, or read
		  aloud, it is still an obvious link that says where it goes. The alt
		  describes the location rather than the picture, because "a map of
		  Chard" helps nobody find us.
		*/}
		<section class="mt-12 border-t border-base-300 pt-8">
			<h2 class="text-3xl font-bold text-primary">{whereWeAre.heading}</h2>

			<address class="mt-3 text-base-content/80 not-italic">
				{addressLines.map((line) => <span class="block">{line}</span>)}
			</address>

			<figure class="mt-5">
				<a
					href={whereWeAre.mapUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="group block rounded-box focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
				>
					<Image
						src={mapImage}
						alt={whereWeAre.mapAlt}
						widths={[512, 768, 1024]}
						sizes="(min-width: 48rem) 48rem, 100vw"
						class="w-full rounded-box border border-base-300"
					/>
					<span class="mt-2 inline-block font-bold text-primary underline">
						{whereWeAre.linkLabel}
					</span>
				</a>
				<figcaption class="mt-2 text-sm text-base-content/60">{whereWeAre.credit}</figcaption>
			</figure>
		</section>

		{/*
		  A role with an address shows straight away; its holder's name joins it
		  once they have agreed to be listed. If nothing is ready, the heading
		  goes too rather than standing over nothing.
		*/}
		{
			committeeRoles.length > 0 && (
				<section class="mt-12 border-t border-base-300 pt-8">
					<h2 class="text-3xl font-bold text-primary">{committee.heading}</h2>
					{committee.intro && (
						<RichText text={committee.intro} class="mt-3 text-base-content/80" />
					)}
					<ul class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2">
						{committeeRoles.map((entry) => (
							<li class="contact-entry">
								<p class="mb-0 font-bold text-primary">{entry.role}</p>
								{entry.name && <p class="mb-0 text-base-content/80">{entry.name}</p>}
								{entry.email && (
									<a href={`mailto:${entry.email}`} class="link link-primary wrap-anywhere">
										{entry.email}
									</a>
								)}
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</Layout>

<style>
	.contact-entry {
		padding-left: 1rem;
		border-left: 3px solid var(--color-base-300);
	}
</style>
