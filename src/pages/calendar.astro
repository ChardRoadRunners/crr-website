---
// Four lists, deliberately in this order.
//
// Club nights, socials and races come from the club's Google calendars, read
// at build time and rendered as ordinary HTML. They change week to week, which
// is what the nightly rebuild is for.
//
// The race diary below is the opposite: rules worked out from race reports,
// fixed at build time, and honest about not knowing exact dates. Keeping them
// on one page and clearly separated means nobody has to guess which is which —
// the calendar's dates are confirmed, the diary's mostly are not.
//
// This replaced a Google Calendar iframe. The embed put a third-party request
// on the page for every visitor, which is the thing self-hosting the fonts was
// meant to avoid, and it could not be styled or made to work without
// JavaScript. Nothing on this page now talks to Google from a browser.
import { getEntry } from 'astro:content';

import ContourDivider from '../components/ContourDivider.astro';
import EventList from '../components/EventList.astro';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import RaceDiary from '../components/RaceDiary.astro';
import RichText from '../components/RichText.astro';
import { getUpcoming } from '../utils/calendar';

const page = await getEntry('pages', 'calendar');
if (page?.data.page !== 'calendar') {
	throw new Error('src/content/pages/calendar.md is missing or is not a calendar page.');
}
const { hero, seo, clubNights, socials, races, championshipLabel, entryLabel, raceDiary } =
	page.data;

const now = new Date();

// Fetched together so one broken feed names itself rather than failing on
// whichever page happened to read it first.
const [nights, socialEvents, upcomingRaces] = await Promise.all([
	getUpcoming(['club-nights'], { now }),
	getUpcoming(['socials'], { now }),
	getUpcoming(['race-calendar', 'championship', 'club-races'], { now }),
]);
---

<Layout title={hero.heading} description={seo.description} overlayHeader>
	<PageHeader heading={hero.heading} strapline={hero.strapline} />

	<div class="mx-auto max-w-3xl px-4 pt-12 pb-10 sm:px-6 lg:px-8">
		<section id="club-calendar" class="scroll-mt-20">
			<h2 class="text-3xl font-bold text-primary">{clubNights.heading}</h2>
			<RichText text={clubNights.intro} class="mt-3 text-base-content/80" />
			<EventList
				events={nights}
				emptyState={clubNights.emptyState}
				championshipLabel={championshipLabel}
				entryLabel={entryLabel}
				class="mt-6"
			/>
		</section>

		{/*
		  Socials get their own list rather than joining the club nights above.
		  A Tuesday run and a Christmas party answer different questions, and
		  the page's own strapline has promised socials since before there was
		  a calendar to fill them.
		*/}
		<section id="socials" class="mt-12 scroll-mt-20">
			<h2 class="text-3xl font-bold text-primary">{socials.heading}</h2>
			<RichText text={socials.intro} class="mt-3 text-base-content/80" />
			<EventList
				events={socialEvents}
				emptyState={socials.emptyState}
				championshipLabel={championshipLabel}
				entryLabel={entryLabel}
				class="mt-6"
			/>
		</section>

		<section id="races-coming-up" class="mt-12 scroll-mt-20">
			<h2 class="text-3xl font-bold text-primary">{races.heading}</h2>
			<RichText text={races.intro} class="mt-3 text-base-content/80" />
			<EventList
				events={upcomingRaces}
				emptyState={races.emptyState}
				championshipLabel={championshipLabel}
				entryLabel={entryLabel}
				class="mt-6"
			/>
		</section>
	</div>

	<ContourDivider />

	<div class="mx-auto max-w-3xl px-4 pt-10 pb-12 sm:px-6 lg:px-8">
		<section id="race-calendar" class="scroll-mt-20">
			<h2 class="text-3xl font-bold text-primary">{raceDiary.heading}</h2>
			<RichText text={raceDiary.intro} class="mt-3 text-base-content/80" />
			<div class="mt-8">
				<RaceDiary />
			</div>
		</section>
	</div>
</Layout>
