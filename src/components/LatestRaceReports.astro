---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import ImageFallback from './ImageFallback.astro';
import { getEarliestRaceDate, sortByRaceDateDesc } from '../utils/race-reports';
import { objectPosition } from '../utils/crop';

interface Props {
	heading: string;
	linkLabel: string;
	emptyState: string;
}

const { heading, linkLabel, emptyState } = Astro.props;

const posts = sortByRaceDateDesc(await getCollection('race-reports', ({ data }) => !data.draft)).slice(0, 3);
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
	<h2 class="text-center text-3xl sm:text-4xl font-bold text-base-content">{heading}</h2>
	{
		posts.length === 0 ? (
			<p class="mt-8 text-center text-base-content/70">{emptyState}</p>
		) : (
			<ul class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-3">
				{posts.map((post) => (
					<li>
						<a
							href={`/race-reports/${post.id}/`}
							class="group block rounded-box focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						>
							<div class="aspect-[2/1] overflow-hidden rounded-box">
								{post.data.heroImage ? (
									<Image
										width={480}
										src={post.data.heroImage}
										alt={post.data.heroImageAlt ?? ''}
										class="h-full w-full object-cover"
										style={{ objectPosition: objectPosition(post.data.heroImageCrop) }}
									/>
								) : (
									<ImageFallback />
								)}
							</div>
							<span class="badge badge-purple badge-sm mt-3">{post.data.category}</span>
							<h3 class="mt-2 text-lg font-bold text-base-content group-hover:underline">{post.data.title}</h3>
							<p class="text-sm text-base-content/60">
								<FormattedDate date={getEarliestRaceDate(post.data.races)} approximate={post.data.dateApproximate} />
							</p>
							<p class="mt-1 line-clamp-2 text-base-content/70">{post.data.excerpt}</p>
						</a>
					</li>
				))}
			</ul>
		)
	}
	<div class="mt-8 text-center">
		<a href="/race-reports" class="link link-primary font-medium">{linkLabel}</a>
	</div>
</section>
