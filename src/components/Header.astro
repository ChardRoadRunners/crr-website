---
import logoMark from '../assets/crr-logo-mark.svg?raw';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { getNavigation } from '../utils/navigation';

interface Props {
	/** Overlay transparently on a hero instead of sitting in normal flow. */
	overlay?: boolean;
	/**
	 * Hide the logo until the bar goes solid.
	 *
	 * The homepage only. Its hero carries a large CRR mark directly below, and
	 * two of them read as a duplicate. Inside pages have no such mark, so
	 * hiding it there would just leave the corner empty.
	 */
	hideLogo?: boolean;
}

const { overlay = false, hideLogo = false } = Astro.props;

const { primary } = await getNavigation();
---

<header
	id="site-header"
	data-scrolled="false"
	class:list={[
		'navbar px-4 text-primary-content sm:px-6 lg:px-8',
		overlay
			? 'site-header--overlay fixed inset-x-0 top-0 z-50 bg-transparent data-[scrolled=true]:bg-primary data-[scrolled=true]:shadow-sm'
			: 'bg-primary shadow-sm',
		overlay && hideLogo && 'site-header--hide-logo',
	]}
>
	{/*
	  w-auto, because daisyUI gives .navbar-start a flat 50% of the bar. At 1024px
	  — the exact width the desktop nav appears at — that reserved 512px for a
	  138px logo and left the (then seven) nav items 500px to fit in, so they wrapped to
	  a second row and the header grew from 64px to 108px. The logo takes what it
	  needs and the nav takes the rest.
	*/}
	<div class="navbar-start w-auto">
		<div class="dropdown">
			<div
				tabindex="0"
				role="button"
				class="btn btn-ghost text-primary-content focus-visible:outline-white lg:hidden"
				aria-label="Open menu"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</div>
			<ul
				tabindex="0"
				class="menu dropdown-content menu-sm z-10 mt-3 w-52 rounded-box bg-primary p-2 text-primary-content shadow-lg"
			>
				{
					primary.map((link) => (
						<li>
							<HeaderLink href={link.href}>{link.label}</HeaderLink>
						</li>
					))
				}
			</ul>
		</div>
		<a
			href="/"
			class="site-logo-link btn btn-ghost px-2 text-sky hover:text-primary-content focus-visible:outline-white"
		>
			{/* The mark reads "CRR", so the link needs the club's full name for
			    anyone who cannot see it. The SVG itself is decorative. */}
			<span class="sr-only">{SITE_TITLE}</span>
			<span class="site-logo" aria-hidden="true" set:html={logoMark} />
		</a>
	</div>
	<div class="navbar-end hidden w-auto flex-1 lg:flex">
		<ul class="menu menu-horizontal gap-1 px-1">
			{
				primary.map((link) => (
					<li>
						<HeaderLink href={link.href}>{link.label}</HeaderLink>
					</li>
				))
			}
		</ul>
	</div>
</header>

<style>
	/* The mark is roughly 2.7:1, so width drives the sizing and height follows. */
	.site-logo {
		display: block;
		width: 5.5rem;
	}

	.site-logo :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	/*
	  Over the hero the header is transparent, and the hero already carries a
	  large CRR mark — a second one in the header read as a duplicate. It
	  arrives with the background rather than sitting there on its own.

	  visibility, not just opacity, so the link leaves the tab order while it
	  is invisible: a keyboard user tabbing to a logo they cannot see has
	  nowhere to look. Nothing is lost by that here — this only applies to the
	  homepage, so the link they cannot reach points at the page they are on.
	*/
	.site-header--overlay {
		transition:
			background-color 150ms ease,
			box-shadow 150ms ease;
	}

	/*
	  A scrim behind the transparent header. Measured against the real hero,
	  nav text over the brightest contour lines fell to 4.1:1 for the white
	  links and 1.7:1 for the pale blue current-page link — the same failure
	  CLAUDE.md warns about for contours behind copy. This puts a floor under
	  the text without giving up the transparent look.

	  It holds full strength across the bar and only tapers below it, because
	  a gradient that starts fading at the top leaves the text sitting at half
	  the scrim it looks like it has.

	  Negative z-index keeps it behind the header's own content while staying
	  inside the header's stacking context, so it still covers the hero.
	*/
	.site-header--overlay::before {
		content: '';
		position: absolute;
		inset: 0 0 -2.5rem 0;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(to bottom, rgba(38, 33, 65, 0.8) 0%, rgba(38, 33, 65, 0.8) 62%, rgba(38, 33, 65, 0) 100%);
		background: linear-gradient(
			to bottom,
			rgb(from var(--color-primary) r g b / 0.8) 0%,
			rgb(from var(--color-primary) r g b / 0.8) 62%,
			rgb(from var(--color-primary) r g b / 0) 100%
		);
		transition: opacity 150ms ease;
	}

	/* Once the bar is solid the scrim has nothing left to do, and the part
	   hanging below it would read as a smudge over the content. */
	.site-header--overlay[data-scrolled='true']::before {
		opacity: 0;
	}

	.site-header--hide-logo .site-logo-link {
		visibility: hidden;
		opacity: 0;
		transition:
			opacity 150ms ease,
			visibility 150ms ease;
	}

	.site-header--hide-logo[data-scrolled='true'] .site-logo-link {
		visibility: visible;
		opacity: 1;
	}

</style>
{
	overlay && (
		<script>
			// The header goes solid almost as soon as the page moves. Waiting
			// until the end of the hero meant content scrolled underneath a
			// transparent bar for most of the hero's height, which is what
			// looked untidy on a phone.
			const SOLID_AFTER_PX = 72;

			const header = document.getElementById('site-header');
			if (header) {
				const onScroll = () => {
					header.dataset.scrolled = String(window.scrollY > SOLID_AFTER_PX);
				};

				// Ran once here and once on load. iOS can report a transient
				// scroll position while the page is still settling, and this
				// only listens for scroll events afterwards — so a wrong first
				// reading would otherwise leave the bar solid over an unscrolled
				// page until somebody touched it.
				onScroll();
				window.addEventListener('load', onScroll);
				window.addEventListener('scroll', onScroll, { passive: true });
			}

			// This script no longer publishes a --header-height variable. It
			// used to, and the hero's top padding was calculated from it, which
			// meant the layout of the first thing anybody sees depended on a
			// measurement taken at whatever moment the script happened to run.
			// The hero uses a plain value now. Don't reintroduce it.
		</script>
	)
}
