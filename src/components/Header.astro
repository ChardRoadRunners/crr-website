---
import logoMark from '../assets/crr-logo-mark.svg?raw';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { getNavigation } from '../utils/navigation';

interface Props {
	/** Overlay transparently on a hero instead of sitting in normal flow. */
	overlay?: boolean;
	/**
	 * Hide the logo until the bar goes solid.
	 *
	 * The homepage only. Its hero carries a large CRR mark directly below, and
	 * two of them read as a duplicate. Inside pages have no such mark, so
	 * hiding it there would just leave the corner empty.
	 */
	hideLogo?: boolean;
}

const { overlay = false, hideLogo = false } = Astro.props;

const { homeLabel, primary, cta } = await getNavigation();
---

<header
	id="site-header"
	data-scrolled="false"
	class:list={[
		// A three-column grid on phones and tablets — Home on the left, the mark
		// in the true centre, Join us on the right — and the usual flex row
		// from lg, where the full menu appears. See the note on .site-mark.
		'navbar site-header grid grid-cols-[1fr_auto_1fr] gap-2 px-4 text-primary-content sm:px-6 lg:flex lg:px-8',
		overlay
			? 'site-header--overlay fixed inset-x-0 top-0 z-50 bg-transparent data-[scrolled=true]:bg-primary data-[scrolled=true]:shadow-sm'
			: 'bg-primary shadow-sm',
		overlay && hideLogo && 'site-header--hide-logo',
	]}
>
	{/*
	  The menu button and a plain "Home". Added 2 November 2026: the logo has
	  always linked home, but members trying the site could not work that out,
	  so the way back is now a word. On a wide screen it moves into the
	  horizontal menu instead, so this whole column hides from lg.
	*/}
	<div class="flex min-w-0 items-center gap-1 justify-self-start lg:hidden">
		<div class="dropdown">
			<div
				tabindex="0"
				role="button"
				class="btn btn-ghost px-3 text-primary-content focus-visible:outline-white"
				aria-label="Open menu"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</div>
			<ul
				tabindex="0"
				class="menu dropdown-content menu-sm z-10 mt-3 w-52 rounded-box bg-primary p-2 text-primary-content shadow-lg"
			>
				{
					primary.map((link) => (
						<li>
							<HeaderLink href={link.href}>{link.label}</HeaderLink>
						</li>
					))
				}
			</ul>
		</div>
		<HeaderLink href="/" class="btn btn-ghost px-2 font-medium">{homeLabel}</HeaderLink>
	</div>

	{/*
	  The mark, centred, in chalk to match the one in the hero. Still a link
	  home: anyone who does try the logo gets there too.

	  lg:order-first puts it back at the left on a wide screen. A centred mark
	  there would leave each side about 430px at 1024px, and the six menu items
	  plus Join us need closer to 700, so they would wrap or push the mark off
	  centre. Logo left, menu right is what a desktop visitor expects anyway.
	*/}
	<div class="site-mark justify-self-center lg:order-first">
		<a
			href="/"
			class="site-logo-link btn btn-ghost px-2 text-chalk hover:text-sky focus-visible:outline-white"
		>
			{/* The mark reads "CRR", so the link needs the club's full name for
			    anyone who cannot see it. The SVG itself is decorative. */}
			<span class="sr-only">{SITE_TITLE}</span>
			<span class="site-logo" aria-hidden="true" set:html={logoMark} />
		</a>
	</div>

	{/*
	  The menu hides below lg; the button does not. Joining is the one thing
	  this site is asking anybody to do, and behind a hamburger it is two taps
	  away on the pages most likely to be somebody's first.
	*/}
	<div class="flex items-center justify-end gap-2 justify-self-end lg:flex-1">
		<ul class="menu menu-horizontal hidden gap-1 px-1 lg:flex">
			<li>
				<HeaderLink href="/">{homeLabel}</HeaderLink>
			</li>
			{
				primary.map((link) => (
					<li>
						<HeaderLink href={link.href}>{link.label}</HeaderLink>
					</li>
				))
			}
		</ul>

		{/*
		  btn-accent: the logo's sky blue as a fill, dark purple text. MEASURED
		  at 8.67:1 — the strongest pairing in the palette, and 2.3 points up on
		  the pale blue btn-secondary this replaced.

		  This is what CLAUDE.md already said a call to action should be, so the
		  button was the outlier rather than the rule. Every other CTA on the
		  site — the hero, Couch to 5k, the race entry links, the 404's way home
		  — was already btn-accent.

		  It stays a FILL. The same sky blue as text on a light ground is
		  1.76:1, the worst number in the palette.
		*/}
		<a
			href={cta.href}
			class="btn btn-accent btn-sm whitespace-nowrap sm:btn-md focus-visible:outline-white"
		>
			{cta.label}
		</a>
	</div>
</header>

<style>
	/*
	  The mark is roughly 2.7:1, so width drives the sizing and height follows.

	  4.5rem on the narrowest phones. The bar centres the mark with a column
	  either side as wide as the wider of menu-plus-Home and Join us, so at
	  320px the full 5.5rem would push the bar wider than the screen.
	*/
	.site-logo {
		display: block;
		width: 4.5rem;
	}

	@media (min-width: 360px) {
		.site-logo {
			width: 5.5rem;
		}
	}

	.site-logo :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	/*
	  Over the hero the header is transparent, and the hero already carries a
	  large CRR mark — a second one in the header read as a duplicate. It
	  arrives with the background rather than sitting there on its own.

	  visibility, not just opacity, so the link leaves the tab order while it
	  is invisible: a keyboard user tabbing to a logo they cannot see has
	  nowhere to look. Nothing is lost by that here — this only applies to the
	  homepage, so the link they cannot reach points at the page they are on.
	*/
	.site-header--overlay {
		transition:
			background-color 150ms ease,
			box-shadow 150ms ease;
	}

	/*
	  A scrim behind the transparent header. Measured against the real hero,
	  nav text over the brightest contour lines fell to 4.1:1 for the white
	  links and 1.7:1 for the pale blue current-page link — the same failure
	  CLAUDE.md warns about for contours behind copy. This puts a floor under
	  the text without giving up the transparent look.

	  It holds full strength across the bar and only tapers below it, because
	  a gradient that starts fading at the top leaves the text sitting at half
	  the scrim it looks like it has.

	  Negative z-index keeps it behind the header's own content while staying
	  inside the header's stacking context, so it still covers the hero.
	*/
	.site-header--overlay::before {
		content: '';
		position: absolute;
		inset: 0 0 -2.5rem 0;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(to bottom, rgba(38, 33, 65, 0.8) 0%, rgba(38, 33, 65, 0.8) 62%, rgba(38, 33, 65, 0) 100%);
		background: linear-gradient(
			to bottom,
			rgb(from var(--color-primary) r g b / 0.8) 0%,
			rgb(from var(--color-primary) r g b / 0.8) 62%,
			rgb(from var(--color-primary) r g b / 0) 100%
		);
		transition: opacity 150ms ease;
	}

	/* Once the bar is solid the scrim has nothing left to do, and the part
	   hanging below it would read as a smudge over the content. */
	.site-header--overlay[data-scrolled='true']::before {
		opacity: 0;
	}

	.site-header--hide-logo .site-logo-link {
		visibility: hidden;
		opacity: 0;
		transition:
			opacity 150ms ease,
			visibility 150ms ease;
	}

	.site-header--hide-logo[data-scrolled='true'] .site-logo-link {
		visibility: visible;
		opacity: 1;
	}

	/*
	  THE HANDOVER, in CSS rather than script (2 November 2026). On the
	  homepage the bar's mark fades in as the hero's mark slides up under the
	  bar, so it looks like one mark taking over from the other.

	  A scroll-driven animation: the browser ties the fade to how far the
	  hero's mark has scrolled, with no JavaScript. Hero.astro names that mark
	  as a "view timeline" (--crr-hero-mark), body makes the name visible to
	  the header, and the fade runs from the moment the hero mark's top meets
	  the bottom of the bar (the 4rem inset, the bar's height) to the moment
	  it has gone under completely.

	  Browsers without scroll-driven animations skip this block and keep the
	  rules above: the mark arrives with the solid bar, 72px down, as it did
	  before. Nothing breaks either way, and no fourth script was needed.

	  An animation outranks the rules above in the cascade, so inside this
	  block the data-scrolled switch no longer decides anything about the
	  mark. It still turns the bar solid.
	*/
	@supports (animation-timeline: view()) {
		:global(body) {
			timeline-scope: --crr-hero-mark;
		}

		/*
		  Longhands, deliberately, and no animation-duration. Written as the
		  `animation` shorthand plus `animation-timeline`, the build's CSS
		  minifier folded the timeline into the shorthand, where browsers do
		  not accept it, and dropped the whole rule: the mark just snapped in
		  at 72px. Leaving one longhand out stops it merging them.
		*/
		.site-header--hide-logo .site-logo-link {
			transition: none;
			animation-name: crr-mark-handover;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: --crr-hero-mark;
			animation-range-start: exit 0%;
			animation-range-end: exit 100%;
		}

		@keyframes crr-mark-handover {
			from {
				opacity: 0;
				visibility: hidden;
			}
			to {
				opacity: 1;
				visibility: visible;
			}
		}
	}

</style>
{
	overlay && (
		<script>
			// The header goes solid almost as soon as the page moves. Waiting
			// until the end of the hero meant content scrolled underneath a
			// transparent bar for most of the hero's height, which is what
			// looked untidy on a phone.
			const SOLID_AFTER_PX = 72;

			const header = document.getElementById('site-header');
			if (header) {
				const onScroll = () => {
					header.dataset.scrolled = String(window.scrollY > SOLID_AFTER_PX);
				};

				// Ran once here and once on load. iOS can report a transient
				// scroll position while the page is still settling, and this
				// only listens for scroll events afterwards — so a wrong first
				// reading would otherwise leave the bar solid over an unscrolled
				// page until somebody touched it.
				onScroll();
				window.addEventListener('load', onScroll);
				window.addEventListener('scroll', onScroll, { passive: true });
			}

			// This script no longer publishes a --header-height variable. It
			// used to, and the hero's top padding was calculated from it, which
			// meant the layout of the first thing anybody sees depended on a
			// measurement taken at whatever moment the script happened to run.
			// The hero uses a plain value now. Don't reintroduce it.
		</script>
	)
}
