---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/app.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
/*
 * The preview card for every page that has no hero of its own — the homepage,
 * Join Us, Calendar, Results, Contact, Our Races, the four legal pages, the
 * archive index and the 404. That is most of the site.
 *
 * It is a committed raster, not the contour SVG at runtime, for two reasons:
 * the image service will not rasterise an SVG, and under
 * passthroughImageService nothing is resized anyway. Generated once from
 * hero-contours-desktop.svg at 1200x630 — the size every platform renders a
 * card at — on the brand purple with the motif's own stroke colours at 0.5.
 *
 * No text is baked into it. CLAUDE.md forbids that, og:title already supplies
 * the words beside the card, and a wordless image cannot go stale.
 */
import FallbackImage from '../assets/social-fallback.jpg';
import { PRE_LAUNCH, SITE_TITLE } from '../consts';
import { Font, getImage } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/**
	 * A ready-made 1200x630 share card, as a path on this site. Race reports
	 * pass one, cut by src/pages/race-reports/[slug]/share.jpg.ts at the crop
	 * the author chose. When set, `image` is not used for the card at all.
	 */
	shareImage?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	shareImage,
} = Astro.props;

/**
 * The preview card image, generated rather than passed through.
 *
 * `image.src` on an ImageMetadata object is the ORIGINAL file. Using it meant
 * every page with a hero shipped that hero twice: once as the derivative its
 * <Image> tag generated at the size the page actually uses, and once whole,
 * for a preview card that renders at 1200x630 no matter what it is sent. On
 * most pages the untouched original was the largest file on the page.
 *
 * Four things here are deliberate:
 *
 * - JPEG, not WebP. This is the one place on the site where WebP is the wrong
 *   answer: support across preview scrapers is patchy and JPEG renders
 *   everywhere. Do not change this to match the rest of the site.
 * - `cover`, because 1200x630 is a wide letterbox and a photo would otherwise
 *   be squashed or padded. Astro maps `fit: 'contain'` to Sharp's `inside`,
 *   which resizes without padding rather than letterboxing, so it is not the
 *   escape route it looks like.
 * - The URL stays absolute. Scrapers reject relative paths.
 * - The FallbackImage default stays, so pages without a hero still get a card.
 *
 * Race reports do not come through here: they pass `shareImage`, a card cut
 * at the post's own crop by src/pages/race-reports/[slug]/share.jpg.ts.
 * Sharp's position option only knows top, centre and bottom, and the five
 * crop positions need the two in between as well. Everything else that
 * reaches this — the fallback card, any page with an image and no crop —
 * is cropped from the centre.
 */
const ogImage = shareImage
	? { src: shareImage }
	: await getImage({
			src: image,
			width: 1200,
			height: 630,
			fit: 'cover',
			format: 'jpeg',
		});
---

<!-- Global Metadata -->
<meta charset="utf-8" />
{
	/*
	  Keeps the site out of search results until it is announced. robots.txt
	  asks crawlers not to visit; this tells the ones that visit anyway not to
	  list what they found, which is the half that actually removes a page from
	  results. Both come off together when PRE_LAUNCH goes false.
	*/
	PRE_LAUNCH && <meta name="robots" content="noindex, nofollow" />
}
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Icons, all generated from the logo mark. SVG for modern browsers, .ico
     (16/32/48) for older ones, and a PNG for iOS: Safari ignores SVG icons
     entirely, and without this it puts a screenshot of the page on the home
     screen instead. The PNG is square-cornered and opaque on purpose — iOS
     applies its own rounded mask and paints black behind any transparency. -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-outfit" preload />
<Font cssVariable="--font-inter" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage.src, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
