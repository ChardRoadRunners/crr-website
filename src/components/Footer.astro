---
import logoLockup from '../assets/crr-logo-lockup.svg?raw';
import { SITE_TITLE } from '../consts';
import ContourBackdrop from './ContourBackdrop.astro';
import { getNavigation, isExternal } from '../utils/navigation';

const year = new Date().getFullYear();

const { footerGroups } = await getNavigation();
---

{/*
  The column labels below are <p>, not <h3>. They label a list of links, they
  are not sections of the page, and as headings they put a 1 -> 3 skip in the
  outline of every page on the site — the footer is the only heading on a page
  like /club-kit that has just an h1 and nothing else.
*/}
<footer class="relative overflow-hidden bg-primary text-primary-content">
	<ContourBackdrop />
	<div class="relative z-1 mx-auto max-w-5xl px-4 pt-10 sm:px-6 lg:px-8">
		{/* Decorative: the club's name is already the footer's copyright line. */}
		<div class="footer-logo" aria-hidden="true" set:html={logoLockup} />
	</div>
	<div class="footer sm:footer-horizontal relative z-1 mx-auto max-w-5xl gap-8 px-4 py-10 sm:px-6 lg:px-8">
		{
			footerGroups.map((group) => (
				<nav>
					<p class="footer-title text-sm font-semibold tracking-wide uppercase text-primary-content/70">
						{group.label}
					</p>
					{group.links.map((link) =>
						isExternal(link.href) ? (
							<a
								href={link.href}
								class="link link-hover text-primary-content hover:text-sky"
								target="_blank"
								rel="noopener noreferrer"
							>
								{link.label}
							</a>
						) : (
							<a href={link.href} class="link link-hover text-primary-content hover:text-sky">
								{link.label}
							</a>
						),
					)}
				</nav>
			))
		}
	</div>
	<div class="relative z-1 border-t border-primary-content/10 px-4 py-4 text-center text-sm text-primary-content/70">
		&copy; {year} {SITE_TITLE}
	</div>
</footer>

<style>
	/*
	  The two-tone treatment, which the footer has room for: the mark takes
	  currentColor and the wordmark takes --logo-accent. On a light ground both
	  would fall back to currentColor and go purple together.
	*/
	.footer-logo {
		--logo-accent: var(--color-sky);
		color: var(--color-chalk);
		width: min(15rem, 60%);
	}

	.footer-logo :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
