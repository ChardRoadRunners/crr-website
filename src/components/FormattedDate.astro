---
// Every date on the site goes through here, so they all read the same way.
// See src/utils/date.ts for the form and why the year is always shown.
import { formatDate } from '../utils/date';

interface Props {
	date: Date;
	// True when the exact day isn't known — render month and year only.
	approximate?: boolean;
	// Frontmatter dates have no time of their own, so they are read in UTC.
	// A real instant (a calendar event) should pass Europe/London.
	timeZone?: string;
	// Set false where the day of the week means nothing — a "last reviewed"
	// date, say. On anything a runner turns up to, leave it on.
	weekday?: boolean;
}

const { date, approximate = false, timeZone = 'UTC', weekday = true } = Astro.props;
---

<time datetime={date.toISOString()}>
	{formatDate(date, { timeZone, monthOnly: approximate, weekday })}
</time>
