---
/**
 * The next few races, from both places the club keeps them.
 *
 * Two sources that answer different questions, deliberately merged rather than
 * one replacing the other:
 *
 * - The **Google race calendars** hold dates somebody has confirmed. Few
 *   entries, all exact.
 * - The **race diary** holds rules worked out from past race reports — "the
 *   last Sunday in November". Many entries, most approximate.
 *
 * Showing only the calendar would empty the homepage whenever the committee
 * were behind. Showing only the diary would hide a race that has actually been
 * booked. So both, with the same honesty rule applied throughout: an exact
 * date prints as a day, a worked-out one says how it is worked out.
 *
 * Where a race is in both — the Chard Flyer is — the calendar wins, because a
 * confirmed date beats an inferred one. See `isSameRace` in utils/calendar for
 * how that is matched, and why it is deliberately cautious.
 */
import { getCollection } from 'astro:content';

import FormattedDate from './FormattedDate.astro';
import { getUpcoming, isSameRace } from '../utils/calendar';
import { describeTiming, hasExactDate, isRunning, nextOccurrence } from '../utils/race-diary';

interface Props {
	heading: string;
	linkLabel: string;
	/** Shown when both sources are empty. */
	emptyState: string;
	championshipLabel: string;
}

const { heading, linkLabel, emptyState, championshipLabel } = Astro.props;

const now = new Date();

interface Entry {
	key: string;
	name: string;
	date: Date;
	/** True when the day itself is known, rather than worked out from a rule. */
	exact: boolean;
	/** How an approximate date is described, e.g. "usually mid-November". */
	timing: string | null;
	championship: boolean;
	/** Timed calendar events carry a time; diary entries and all-day ones don't. */
	showTime: boolean;
}

const fromCalendar: Entry[] = (
	await getUpcoming(['race-calendar', 'championship', 'club-races'], { now })
).map((event) => ({
	key: event.uid,
	name: event.title,
	date: event.start,
	exact: true,
	timing: null,
	championship: event.isChampionship,
	showTime: !event.allDay,
}));

const fromDiary: Entry[] = (await getCollection('calendar-events'))
	.filter((event) => isRunning(event.data))
	.map((event) => ({ event, date: nextOccurrence(event.data, now) }))
	.filter((item): item is { event: (typeof item)['event']; date: Date } => Boolean(item.date))
	.map(({ event, date }) => ({
		key: `diary:${event.id}`,
		name: event.data.name,
		date,
		exact: hasExactDate(event.data, now),
		timing: describeTiming(event.data),
		championship: event.data.championship,
		showTime: false,
	}))
	// A race the committee has actually booked is the better record of it.
	// isSameRace explains how the two sources' names are reconciled.
	.filter((entry) => !fromCalendar.some((c) => isSameRace(c.name, entry.name, c.date, entry.date)));

const next = [...fromCalendar, ...fromDiary]
	.sort((a, b) => a.date.getTime() - b.date.getTime())
	.slice(0, 4);
---

<section class="bg-base-200">
	<div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
		<h2 class="text-center text-3xl sm:text-4xl font-bold text-base-content">{heading}</h2>

		{
			next.length === 0 ? (
				<p class="mt-4 text-center text-base-content/70">{emptyState}</p>
			) : (
				<ul class="mx-auto mt-8 flex max-w-md flex-col gap-3">
					{next.map((entry) => (
						<li class:list={['coming-up-entry', entry.exact ? 'is-exact' : 'is-approximate']}>
							<span class="font-bold text-primary">{entry.name}</span>
							{entry.championship && (
								<span class="badge badge-purple badge-wrap ml-2 align-middle">
									{championshipLabel}
								</span>
							)}
							<span class="block text-sm text-base-content/80">
								{entry.exact ? (
									<strong>
										<FormattedDate
											date={entry.date}
											timeZone={entry.showTime ? 'Europe/London' : 'UTC'}
										/>
									</strong>
								) : (
									entry.timing
								)}
							</span>
						</li>
					))}
				</ul>
			)
		}

		<div class="mt-6 text-center">
			<a href="/calendar#race-calendar" class="link link-primary font-medium">{linkLabel}</a>
		</div>
	</div>
</section>

<style>
	/* Matching the diary: solid rule for a checked date, dashed for a worked-out
	   one, so the two mean the same thing in both places. */
	.coming-up-entry {
		padding: 0.5rem 0 0.5rem 0.85rem;
		border-left: 3px solid var(--color-base-300);
	}

	.coming-up-entry.is-exact {
		border-left-style: solid;
		border-left-color: var(--color-primary);
	}

	.coming-up-entry.is-approximate {
		border-left-style: dashed;
	}
</style>
