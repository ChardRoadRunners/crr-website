---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import ImageFallback from './ImageFallback.astro';
import { formatDistance } from '../utils/distance';
import RichText from './RichText.astro';
import { resolveRaceDate } from '../utils/calendar';

interface Props {
	heading: string;
	intro: string;
	linkLabel: string;
}

const { heading, intro, linkLabel } = Astro.props;

const now = new Date();

// Dates come from the club-races calendar — see resolveRaceDate, and the note
// on the Our Races page.
const races = await Promise.all(
	(await getCollection('races'))
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (race) => ({
			race,
			when: await resolveRaceDate(race.data.title, race.data.nextDate, now),
		})),
);
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="text-3xl sm:text-4xl font-bold text-base-content">{heading}</h2>
		<RichText text={intro} class="mt-3 text-base-content/70" />
	</div>
	<ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
		{
			races.map(({ race, when }) => {
				const note = race.data.seriesNote || race.data.juniorRaceNote;
				return (
					<li>
						<a
							href="/our-races"
							class="group block overflow-hidden rounded-box border border-base-300 shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						>
							<div class="aspect-[2/1] overflow-hidden">
								{race.data.heroImage ? (
									<Image
										width={480}
										height={240}
										src={race.data.heroImage}
										alt={race.data.heroImageAlt ?? ''}
										class="h-full w-full object-cover object-hero"
									/>
								) : (
									<ImageFallback />
								)}
							</div>
							<div class="p-4">
								<h3 class="text-lg font-bold text-base-content group-hover:underline">{race.data.title}</h3>
								<p class="text-sm text-base-content/60">
									{when.date && (
										<>
											<FormattedDate
												date={when.date}
												timeZone={when.showTime ? 'Europe/London' : 'UTC'}
											/>{' '}
											·{' '}
										</>
									)}
									{formatDistance(race.data.distance)}
								</p>
								{note && <p class="mt-2 text-sm text-base-content/70">{note}</p>}
							</div>
						</a>
					</li>
				);
			})
		}
	</ul>
	<div class="mt-8 text-center">
		<a href="/our-races" class="link link-primary font-medium">{linkLabel}</a>
	</div>
</section>
